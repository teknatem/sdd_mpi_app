!.claude/skills/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database — рабочая БД живёт вне репозитория (F:\data\<проект>), см. [database].path.
# Ловим любые *.db в дереве: так в репо когда-то попал пустой marketplace.db.
*.db
*.db-shm
*.db-wal

# But keep backup scripts
!/scripts/*.ps1

# Logs
*.log
/task_logs/

# Runtime-каталоги приложения: данные, не исходники. Вычищены из истории 2026-08-02.
/downloads/
/csv_export/
/uploads/

# Генерируемые артефакты инструментов (машинно-специфичны)
/.sdd/

