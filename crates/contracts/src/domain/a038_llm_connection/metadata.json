{
  "$schema": "../../../schemas/metadata.schema.json",
  "schema_version": "1.0",
  "entity_type": "aggregate",
  "entity_name": "LlmConnection",
  "entity_index": "a038",
  "collection_name": "llm_connection",
  "table_name": "a038_llm_connection",
  "ui": {
    "element_name": "Подключение LLM",
    "element_name_en": "LLM Connection",
    "list_name": "Подключения LLM",
    "list_name_en": "LLM Connections",
    "icon": "plug-connected"
  },
  "ai": {
    "tags": ["llm"],
    "description": "Техническое подключение к провайдеру LLM (OpenAI, OpenRouter, DeepSeek). Содержит API-ключ, эндпоинт, параметры модели (temperature, max_tokens) и курируемый список разрешённых моделей (allowed_models). Персона (роль, промпт) вынесена на «виртуального сотрудника» a017, который ссылается на это подключение. Чат работает через сотрудника и переключает модель в пределах allowed_models.",
    "questions": [
      "Какие LLM подключения настроены?",
      "Как добавить подключение OpenRouter?",
      "Какие модели разрешены для подключения?",
      "Как изменить список моделей подключения?"
    ],
    "related": [
      "a018_llm_chat",
      "a019_llm_artifact"
    ]
  },
  "fields": [
    {
      "name": "id",
      "rust_type": "LlmConnectionId",
      "field_type": "primitive",
      "source": "base",
      "ui": {
        "label": "ID",
        "label_en": "ID",
        "visible_in_list": false,
        "visible_in_form": false
      },
      "validation": {
        "required": true
      }
    },
    {
      "name": "code",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "base",
      "ui": {
        "label": "Код",
        "label_en": "Code",
        "placeholder": "OPENROUTER-MAIN",
        "hint": "Уникальный код подключения",
        "visible_in_list": true,
        "visible_in_form": true,
        "column_width": 150
      },
      "validation": {
        "required": true,
        "max_length": 50
      }
    },
    {
      "name": "description",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "base",
      "ui": {
        "label": "Наименование",
        "label_en": "Name",
        "placeholder": "OpenRouter основное подключение",
        "hint": "Описательное название подключения",
        "visible_in_list": true,
        "visible_in_form": true,
        "column_width": 250
      },
      "validation": {
        "required": true,
        "min_length": 3,
        "max_length": 255
      }
    },
    {
      "name": "comment",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "base",
      "ui": {
        "label": "Комментарий",
        "label_en": "Comment",
        "placeholder": "Используется для аналитики продаж",
        "hint": "Произвольный комментарий",
        "visible_in_list": false,
        "visible_in_form": true,
        "widget": "textarea"
      },
      "validation": {
        "required": false,
        "max_length": 1000
      }
    },
    {
      "name": "provider_type",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Провайдер",
        "label_en": "Provider",
        "hint": "Тип провайдера LLM",
        "visible_in_list": true,
        "visible_in_form": true,
        "widget": "select",
        "column_width": 120
      },
      "validation": {
        "required": true
      },
      "ai_hint": "Реально поддерживаемые провайдеры: OpenAI (GPT), OpenRouter (кросс-вендорный OpenAI-совместимый роутинг), DeepSeek и Kimi/Moonshot (нативные OpenAI-совместимые API), Ollama (локальная модель на этой машине, ключ не требуется)"
    },
    {
      "name": "api_endpoint",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "API Endpoint",
        "label_en": "API Endpoint",
        "placeholder": "https://openrouter.ai/api/v1",
        "hint": "URL эндпоинта API провайдера",
        "visible_in_list": false,
        "visible_in_form": true,
        "column_width": 300
      },
      "validation": {
        "required": true,
        "max_length": 500,
        "pattern": "^https?://.+",
        "custom_error": "URL должен начинаться с http:// или https://"
      },
      "ai_hint": "OpenAI: https://api.openai.com/v1, OpenRouter: https://openrouter.ai/api/v1, DeepSeek: https://api.deepseek.com, Kimi: https://api.moonshot.ai/v1, Ollama: http://localhost:11434/v1"
    },
    {
      "name": "api_key",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "API Ключ",
        "label_en": "API Key",
        "placeholder": "sk-...",
        "hint": "API ключ для аутентификации",
        "visible_in_list": false,
        "visible_in_form": true,
        "widget": "password"
      },
      "validation": {
        "required": false,
        "max_length": 500
      },
      "ai_hint": "Хранится в зашифрованном виде. Обязателен для всех провайдеров, кроме локальной Ollama — у неё ключа не существует, поле остаётся пустым."
    },
    {
      "name": "model_name",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Модель по умолчанию",
        "label_en": "Default Model",
        "placeholder": "openai/gpt-4o",
        "hint": "Модель по умолчанию для новых чатов",
        "visible_in_list": true,
        "visible_in_form": true,
        "column_width": 150
      },
      "validation": {
        "required": true,
        "max_length": 100
      },
      "ai_hint": "Должна входить в allowed_models. OpenAI: gpt-4o. OpenRouter: openai/gpt-4o, anthropic/claude-sonnet-5, deepseek/deepseek-chat. DeepSeek (нативно): deepseek-chat, deepseek-reasoner"
    },
    {
      "name": "available_models",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Доступные модели",
        "label_en": "Available Models",
        "hint": "JSON список моделей из API (кэш fetch-models)",
        "visible_in_list": false,
        "visible_in_form": false,
        "widget": "textarea"
      },
      "validation": {
        "required": false
      },
      "ai_hint": "JSON массив объектов с полями id, created, owned_by. Загружается из /v1/models API провайдера."
    },
    {
      "name": "allowed_models",
      "rust_type": "String",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Разрешённые модели",
        "label_en": "Allowed Models",
        "hint": "Курируемый короткий список моделей (JSON-массив id)",
        "visible_in_list": false,
        "visible_in_form": true,
        "widget": "textarea"
      },
      "validation": {
        "required": false
      },
      "ai_hint": "JSON массив model_id — подмножество available_models. Только эти модели можно выбрать в чате. Держите 3-8 технически совместимых и целесообразных моделей."
    },
    {
      "name": "temperature",
      "rust_type": "f64",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Temperature",
        "label_en": "Temperature",
        "placeholder": "0.7",
        "hint": "Креативность ответов (0.0-2.0)",
        "visible_in_list": false,
        "visible_in_form": true
      },
      "validation": {
        "required": true,
        "min": 0.0,
        "max": 2.0
      },
      "ai_hint": "0.0 - детерминированно, 1.0 - сбалансированно, 2.0 - максимально креативно"
    },
    {
      "name": "max_tokens",
      "rust_type": "i32",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Max Tokens",
        "label_en": "Max Tokens",
        "placeholder": "4096",
        "hint": "Максимальная длина ответа",
        "visible_in_list": false,
        "visible_in_form": true
      },
      "validation": {
        "required": true,
        "min": 256,
        "max": 128000
      },
      "ai_hint": "GPT-4o поддерживает до 128k токенов"
    },
    {
      "name": "context_window",
      "rust_type": "i32",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Размер контекста",
        "label_en": "Context window",
        "placeholder": "160000",
        "hint": "Окно контекста модели в токенах — из него считается бюджет истории чата",
        "visible_in_list": false,
        "visible_in_form": true
      },
      "validation": {
        "required": true,
        "min": 4096,
        "max": 2000000
      },
      "ai_hint": "Бюджет компакции истории = context_window * 3/4. Для локальной Ollama значение должно совпадать с фактическим num_ctx сервера (OLLAMA_CONTEXT_LENGTH), иначе промпт будет молча обрезаться."
    },
    {
      "name": "is_primary",
      "rust_type": "bool",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Основное",
        "label_en": "Primary",
        "hint": "Использовать по умолчанию",
        "visible_in_list": true,
        "visible_in_form": true,
        "widget": "checkbox",
        "column_width": 100
      },
      "validation": {
        "required": false
      },
      "ai_hint": "Только одно подключение может быть основным. При установке флага автоматически снимается с других."
    },
    {
      "name": "price_in_per_mtok",
      "rust_type": "Option<f64>",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Цена входа за 1M токенов",
        "label_en": "Input price per 1M tokens",
        "placeholder": "3.0",
        "hint": "Ставка тарификации входных токенов. Пусто — стоимость не считается",
        "visible_in_list": false,
        "visible_in_form": true
      },
      "validation": {
        "required": false,
        "min": 0
      },
      "ai_hint": "Прайс за миллион токенов в валюте currency. Пустое поле означает «прайс не задан» — стоимость прогонов по этому подключению не рассчитывается. Явный 0 — это реальная цена (локальная модель)."
    },
    {
      "name": "price_out_per_mtok",
      "rust_type": "Option<f64>",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Цена выхода за 1M токенов",
        "label_en": "Output price per 1M tokens",
        "placeholder": "15.0",
        "hint": "Ставка тарификации выходных токенов",
        "visible_in_list": false,
        "visible_in_form": true
      },
      "validation": {
        "required": false,
        "min": 0
      },
      "ai_hint": "Выходные токены почти всегда дороже входных — считать стоимость по одной усреднённой ставке нельзя."
    },
    {
      "name": "price_cached_per_mtok",
      "rust_type": "Option<f64>",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Цена кэш-входа за 1M токенов",
        "label_en": "Cached input price per 1M tokens",
        "placeholder": "0.3",
        "hint": "Пусто — скидки нет, кэш считается по входной ставке",
        "visible_in_list": false,
        "visible_in_form": true
      },
      "validation": {
        "required": false,
        "min": 0
      },
      "ai_hint": "Кэшированные входные токены — подмножество входных, а не добавка. Пустое поле трактуется как «скидки нет»: незаполненный прайс не должен занижать стоимость."
    },
    {
      "name": "currency",
      "rust_type": "Option<String>",
      "field_type": "primitive",
      "source": "specific",
      "ui": {
        "label": "Валюта прайса",
        "label_en": "Price currency",
        "placeholder": "RUB",
        "hint": "Валюта ставок: RUB, USD, …",
        "visible_in_list": false,
        "visible_in_form": true
      },
      "validation": {
        "required": false,
        "max_length": 8
      },
      "ai_hint": "Конвертацией курсов подсистема стоимости не занимается: суммы в разных валютах не смешиваются, а разделяются в отчёте."
    }
  ],

  "access": {
    "scope_id": "a038_llm_connection",
    "operations": [
      { "id": "list",   "required_mode": "read" },
      { "id": "get",    "required_mode": "read" },
      { "id": "upsert", "required_mode": "all" },
      { "id": "delete", "required_mode": "all" }
    ]
  }
}
