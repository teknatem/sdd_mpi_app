# Marketplace Integrator Configuration
# This file configures where data lives and other settings
#
# IMPORTANT: Place this file next to backend.exe and rename it to config.toml

[data]
# ЕДИНСТВЕННАЯ настройка расположения данных — общий корень. Путь ОБЯЗАН быть
# абсолютным: относительный «переезжал» бы вслед за рабочим каталогом процесса.
#
# Под корнем — фиксированная раскладка (каталоги создаются при старте):
#   db/app.db          база SQLite
#   knowledge/         база знаний (Obsidian-совместимые MD)
#   skills/            внешний каталог навыков LLM
#   chats/             рабочие каталоги чатов
#   golden_set/        эталонные кейсы регрессии качества
#   quality_checks/    внешние MJS-проверки
#   attachments/       вложения чатов
#   backups/           локальные архивы
#   tmp/               промежуточные файлы
# Одинаковая раскладка на всех экземплярах — то, на чём держится перенос
# наборов данных (см. docs/DATASETS_TRANSFER.md).
#
# WINDOWS USERS: Use forward slashes (/) instead of backslashes (\)
# Windows accepts both types of slashes, but TOML requires special
# handling for backslashes in double-quoted strings.
#
# ✓ CORRECT (forward slashes):
# root = "C:/Users/username/Desktop/MPI/data"
#
# ✓ ALSO CORRECT (double backslashes):
# root = "C:\\Users\\username\\Desktop\\MPI\\data"
#
# ✓ ALSO CORRECT (single quotes for literal string):
# root = 'C:\Users\username\Desktop\MPI\data'
#
# ❌ WRONG (will cause parse error):
# root = "C:\Users\username\Desktop\MPI\data"
#
# ❌ WRONG (relative path — rejected at startup):
# root = "data"
#
# Linux/Mac: root = "/var/lib/marketplace"
root = "F:/data/sdd_mpi_app"

# --- Отклонения от общего корня ---------------------------------------------
# Всё, что закомментировано ниже, в основном режиме задавать НЕ НУЖНО: каждый
# путь выводится из [data].root. Раскомментируйте, только если каталог обязан
# жить в другом месте (например, база — на отдельном диске).
#
# Приоритет резолюции пути:
#   1) абсолютный путь в своей секции → как есть, каталог уходит из-под корня;
#   2) [data].root → <root>/<фиксированное имя>;
#   3) без корня → относительно каталога бинарника (историческое поведение).
#
# Каталог с индивидуальным путём помечается в UI «Наборы данных» отдельным
# бейджем и выпадает из единой раскладки — держите этот список пустым, пока нет
# причины для обратного.

# [database]
# Путь к файлу БД. Не задан → <[data].root>/db/app.db.
# Если задан — обязан быть абсолютным. Каталог создаётся автоматически.
# path = "D:/db/app.db"

# [llm]
# Директория с Obsidian-совместимыми MD-файлами базы знаний.
# knowledge_base_path = "D:/knowledge"
# Внешний каталог навыков. Новый формат: <id>/SKILL.md + references/scripts/schemas;
# корневые *.md поддерживаются для совместимости.
# skills_path = "D:/skills"
# Корень рабочих каталогов чатов: <chat_id>/<NNN-активность>/{intake.md,plan.md,notes.md,steps/}.
# chat_files_path = "D:/chats"
# Эталонные кейсы для регрессии качества («голден-сет»): <case-id>.md с frontmatter
# (question / expect / agent_type). Прогоняются задачей task028_llm_golden_set.
# golden_set_path = "D:/golden_set"
# Корень файловых вложений чатов: <chat_id>/<uuid>.<ext>. В БД хранится ключ
# относительно этого корня.
# attachments_path = "D:/attachments"

# [quality]
# Внешние MJS-проверки: <check-id>/{check.json,check.mjs,schema.json?}.
# Пакет с тем же id атомарно переопределяет встроенную проверку после reload.
# checks_path = "D:/quality_checks"

[scheduled_tasks]
enabled = false

[bitrix24]
# Обмен тикетами выполняется глобальным планировщиком каждые 5 минут.
# Время запуска и отметки в UI показываются по Москве (UTC+3).
enabled = false
# Полный URL входящего вебхука, например:
# https://example.bitrix24.ru/rest/1/secret-token/
webhook_url = ""
group_id = 5
responsible_id = 0
# Для двусторонних текстовых комментариев вебхуку также требуется scope "im".
sync_comments = true

[instance]
# Кто этот экземпляр. Попадает в манифест каждого снапшота наборов данных,
# чтобы на принимающей стороне было видно, откуда приехали данные.
# id — стабильный slug, попадает в S3-ключи; пусто → имя машины.
id = ""
# Человекочитаемое имя для интерфейса; пусто → id.
label = ""
# production | staging | dev. Показывается бейджем рядом с каждым снапшотом,
# чтобы «Тестовый» нельзя было спутать с «Рабочим» при восстановлении.
env = ""

[datasets]
# Сколько последних снапшотов ЭТОГО экземпляра хранить в бакете. Снапшоты
# других экземпляров ротация не трогает никогда — иначе тестовый инстанс
# снёс бы бэкапы рабочего.
keep_per_instance = 10
# Потолок размера zip-архива ФАЙЛОВЫХ наборов. Дополнительно ограничен
# [s3].max_upload_mb: этот объект собирается в памяти целиком.
max_bundle_mb = 256
# Отдельный потолок для снимка базы данных (до сжатия). Под max_bundle_mb он не
# попадает: объект грузится потоком по частям и в память целиком не читается.
max_db_gb = 20
# Разрешить включать вложения чатов в снапшоты. Выключено по умолчанию:
# единственный набор, растущий от действий пользователей.
attachments_enabled = false

[external_api]
# Статический API-ключ для внешних интеграций (например, 1С).
# Передаётся в заголовке: X-Api-Key: <значение>
# Если пустая строка — внешний API отключён (возвращает 503).
api_key = ""

[ui]
# Смещение часового пояса для отображения времени в интерфейсе.
# Константа дублируется в frontend/src/shared/date_utils.rs (TZ_OFFSET_HOURS).
timezone_offset_hours = 3

[s3]
# Manual S3 file manager. Keep disabled until bucket and credentials are configured.
enabled = false
endpoint = "https://storage.yandexcloud.net"
region = "ru-central1"
bucket = ""
access_key_id = ""
secret_access_key = ""
max_upload_mb = 512

[mail]
# Почтовый ящик для LLM: приём (IMAP) и отправка (SMTP). Домен xmx.ru на reg.ru.
# Секреты (password) держи только в config.toml — он в .gitignore.
enabled = false
# Приём (IMAP over SSL, порт 993). Для reg.ru shared-хостинга это mail.hosting.reg.ru
# (у mail.<домен> TLS-сертификат не совпадает по имени — не используй его как хост).
imap_host = "mail.hosting.reg.ru"
imap_port = 993
# Отправка (SMTP over implicit SSL, порт 465; для STARTTLS используй 587).
smtp_host = "mail.hosting.reg.ru"
smtp_port = 465
# Учётные данные ящика (полный адрес как логин).
username = "bot@example.com"
password = ""
# Адрес и имя в поле From (если пусто — берётся username).
from_address = "bot@example.com"
from_name = "XMX Bot"
# Rate-limit отправки: не более send_rate_limit писем за send_rate_window_secs секунд.
# 0 отключает ограничение. Приём/отправка в любом случае разрешены только на
# email-адреса зарегистрированных активных пользователей (таблица sys_users).
send_rate_limit = 20
send_rate_window_secs = 3600
# Базовый URL приложения для ссылки на чат/артефакт в ответных письмах (пусто — без ссылки).
base_url = ""
